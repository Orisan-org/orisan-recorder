{"version":3,"term":{"cols":128,"rows":40},"timestamp":1787755423,"command":"node dist/cli.js showcase --scan-home /tmp/orisan-demo-home --pause 1400 --dir /tmp/orisan-demo","env":{"SHELL":"/bin/zsh"}}
[0.089, "o", "\r\n\u001b[1mOrisan Recorder -- showcase\u001b[0m\r\n"]
[0.000, "o", "\u001b[2mEverything below runs for real: the witness at https://witness.orisan.org,\u001b[0m\r\n\u001b[2ma real timestamp from freetsa.org, and openssl doing the checking.\u001b[0m\r\n"]
[1.401, "o", "\r\n\u001b[1m\u001b[36m-- 1. What is on this machine\u001b[0m\r\n\u001b[2m   Including agents nobody registered.\u001b[0m\r\n\r\n"]
[0.902, "o", "\u001b[2m   Scanning a fabricated home directory, not this machine: a published\u001b[0m\r\n\u001b[2m   recording of a real one is an inventory of its owner. Run `orisan-rec\u001b[0m\r\n\u001b[2m   scan` with no arguments to read yours.\u001b[0m\r\n"]
[0.000, "o", "\u001b[2m$ orisan-rec scan --home /tmp/orisan-demo-home --no-processes\u001b[0m\r\n"]
[0.073, "o", "scanned /tmp/orisan-demo-home (darwin)\r\n\r\n"]
[0.000, "o", "  Claude Desktop  /tmp/orisan-demo-home/Library/Application Support/Claude/claude_desktop_config.json\r\n    filesystem               npx -y @modelcontextprotocol/server-filesystem /Users/demo/projects  [config]\r\n    memory                   npx -y @modelcontextprotocol/server-memory  [config]\r\n  Claude Code  /tmp/orisan-demo-home/.claude.json\r\n    (configured, no servers)\r\n  Unknown (generic mcpServers)  /tmp/orisan-demo-home/.mcp.json\r\n    github                   npx -y @modelcontextprotocol/server-github  [config]\r\n  Unknown (generic mcpServers)  /tmp/orisan-demo-home/projects/notes-app/.mcp.json\r\n    sqlite                   uvx mcp-server-sqlite --db-path ./notes.db  [config]\r\n\r\n  4 server(s) across 4 surface(s)\r\n  GAP: process scan skipped at the caller's request; running servers were not looked for\r\n"]
[1.406, "o", "\r\n\u001b[1m\u001b[36m-- 2. Record a session\u001b[0m\r\n\u001b[2m   A fabricated session, labelled as such -- no real agent is being driven here.\u001b[0m\r\n\r\n"]
[0.903, "o", "\u001b[2m$ orisan-rec demo /tmp/orisan-demo --events 18\u001b[0m\r\n"]
[0.129, "o", "wrote 18 events (1 flagged) to /tmp/orisan-demo\r\nhead: seq=17 hash=359e50a04defd507a36a5c48e0dd8b14c8ab607d0394ee1576685988aa5a3413\r\nno checkpoints were cut; run `orisan-rec checkpoint` then `anchor`\r\n"]
[1.405, "o", "\r\n\u001b[1m\u001b[36m-- 3. What was recorded\u001b[0m\r\n\u001b[2m   Read back from the log on disk, not from memory.\u001b[0m\r\n\r\n"]
[0.906, "o", "   \u001b[2m14:43:22\u001b[0m  config_change session.start\r\n   \u001b[2m14:43:27\u001b[0m  model_call    claude-sonnet-4-5\r\n   \u001b[2m14:43:27\u001b[0m  tool_call     shell.exec\r\n   \u001b[2m14:43:33\u001b[0m  tool_call     fs.read\r\n   \u001b[2m14:43:35\u001b[0m  tool_call     mcp__fake-crm__list_tickets\r\n   \u001b[2m14:43:37\u001b[0m  model_call    claude-opus-4-8\r\n   \u001b[2m14:43:38\u001b[0m  tool_call     mcp__fake-crm__list_tickets\r\n   \u001b[2m14:43:41\u001b[0m  tool_call     fs.write\r\n"]
[0.000, "o", "   \u001b[2m... 10 more\u001b[0m\r\n\r\n   18 actions, 1 flagged\r\n"]
[1.403, "o", "\r\n\u001b[1m\u001b[36m-- 4. Commit it outside this machine\u001b[0m\r\n\u001b[2m   A summary is signed, timestamped by an outside authority, and sent to the witness.\u001b[0m\r\n\r\n"]
[0.901, "o", "\u001b[2m$ orisan-rec witness register /tmp/orisan-demo --url https://witness.orisan.org --key /tmp/orisan-demo-key/signing.key\u001b[0m\r\n"]
[0.418, "o", "registered with https://witness.orisan.org\r\n  log_id        f461ae1a-b320-4491-93d7-52ef14cf1775\r\n  witness key   PINNED (MCowBQYDK2VwAyEAtexDyPqP…)\r\n  this key is never re-learned; a response signed by any other key is treated as an attack\r\n"]
[1.441, "o", "\u001b[2m$ orisan-rec checkpoint /tmp/orisan-demo --key /tmp/orisan-demo-key/signing.key\u001b[0m\r\n"]
[0.255, "o", "checkpoint 0..17 (18 events)\r\n  merkle_root a189af07ca5f33a3f0dc2d6fd034f0a274f389442334e502848870348ac39f66\r\n  unanchored — run `orisan-rec anchor` to commit it externally\r\n"]
[1.405, "o", "\u001b[2m$ orisan-rec anchor /tmp/orisan-demo --tsa https://freetsa.org/tsr\u001b[0m\r\n"]
[0.069, "o", "anchoring 1 checkpoint(s) to https://freetsa.org/tsr\r\n"]
[0.286, "o", "  ..17  anchored\r\n"]
[1.430, "o", "\u001b[2m$ orisan-rec witness submit /tmp/orisan-demo --key /tmp/orisan-demo-key/signing.key\u001b[0m\r\n"]
[0.098, "o", "nothing pending: every checkpoint has a receipt\r\n"]
[1.408, "o", "\r\n\u001b[2m   the agent keeps working, and a second batch is committed\u001b[0m\r\n\r\n\u001b[2m$ orisan-rec demo /tmp/orisan-demo --events 14\u001b[0m\r\n"]
[0.116, "o", "wrote 14 events (1 flagged) to /tmp/orisan-demo\r\nhead: seq=31 hash=e31efa156cf192996b6dc0161ea8523fa52ffad373c620c7b4d833d8b7cd6878\r\n"]
[0.000, "o", "no checkpoints were cut; run `orisan-rec checkpoint` then `anchor`\r\n"]
[1.404, "o", "\u001b[2m$ orisan-rec checkpoint /tmp/orisan-demo --key /tmp/orisan-demo-key/signing.key\u001b[0m\r\n"]
[0.285, "o", "checkpoint 18..31 (14 events)\r\n  merkle_root 100b7303a00a5bd08b760e889753c459786287be5a31b9430eb2a171af2f725b\r\n  unanchored — run `orisan-rec anchor` to commit it externally\r\n"]
[1.406, "o", "\u001b[2m$ orisan-rec anchor /tmp/orisan-demo --tsa https://freetsa.org/tsr\u001b[0m\r\n"]
[0.071, "o", "anchoring 1 checkpoint(s) to https://freetsa.org/tsr\r\n"]
[0.270, "o", "  ..31  anchored\r\n"]
[1.431, "o", "\u001b[2m$ orisan-rec witness submit /tmp/orisan-demo --key /tmp/orisan-demo-key/signing.key\u001b[0m\r\n"]
[0.068, "o", "nothing pending: every checkpoint has a receipt\r\n"]
[1.404, "o", "\u001b[2m$ curl -o tsa-ca.pem https://freetsa.org/files/cacert.pem\u001b[0m\r\n"]
[0.344, "o", "   fetched the timestamp authority certificate\r\n"]
[1.401, "o", "\r\n\u001b[1m\u001b[36m-- 5. Check it\u001b[0m\r\n\u001b[2m   Chain, signatures, timestamps, and the witness. openssl checks the timestamp, not us.\u001b[0m\r\n\r\n"]
[0.901, "o", "\u001b[2m$ orisan-rec verify /tmp/orisan-demo --tsa-ca /tmp/orisan-demo/tsa-ca.pem\u001b[0m\r\n"]
[0.309, "o", "orisan-rec verify /tmp/orisan-demo\r\n  events: 32  checkpoints: 2  anchors verified: 2\r\n\r\n  timestamp checks were delegated to openssl — re-run these yourself:\r\n    /opt/homebrew/bin/openssl ts -verify -digest c1d2b344ca2374c23e9f8c1cd800632581f13469605e080e84ad09c61a50ac84 -in /tmp/orisan-demo/anchors/00000017.tsr -CAfile /tmp/orisan-demo/tsa-ca.pem\r\n    /opt/homebrew/bin/openssl ts -verify -digest bf47d719717e213505dd2e9291279b3138afabb5b2ba7b0314cbd60479e71838 -in /tmp/orisan-demo/anchors/00000031.tsr -CAfile /tmp/orisan-demo/tsa-ca.pem\r\n\r\n  attested times (openssl ts -reply -in <tsr> -text):\r\n    checkpoint ..17  2026-08-26T14:43:57.000Z\r\n    checkpoint ..31  2026-08-26T14:44:03.000Z\r\n\r\n  CLEAN — chain intact, every checkpoint signed, every checkpoint anchored\r\n          and every anchor accepted by openssl against the supplied TSA CA.\r\n"]
[1.406, "o", "   \u001b[32mexit 0\u001b[0m\r\n"]
[1.400, "o", "\r\n\u001b[1m\u001b[36m-- 6. Now delete the end of the log\u001b[0m\r\n\u001b[2m   Actions, the summary covering them, its timestamp and its receipt.\u001b[0m\r\n\r\n"]
[0.906, "o", "   \u001b[31mdeleted\u001b[0m 14 actions, one summary, its timestamp and its receipt\r\n   18 actions remain, and they are internally consistent\r\n"]
[1.401, "o", "\r\n\u001b[1m\u001b[36m-- 7. What a simple integrity check sees\u001b[0m\r\n\u001b[2m   Only whether the remaining records are consistent with each other.\u001b[0m\r\n\r\n"]
[0.900, "o", "\u001b[2m$ orisan-rec chain /tmp/orisan-demo\u001b[0m\r\n"]
[0.080, "o", "chain intact: 18 events, head 359e50a04defd507a36a5c48e0dd8b14c8ab607d0394ee1576685988aa5a3413\r\nindex: 32 rows\r\nNOTE: this is chain integrity only. It cannot detect a chain recomputed\r\n      from genesis. Use `orisan-rec verify` for that.\r\n"]
[1.404, "o", "   \u001b[32mexit 0\u001b[0m   \u001b[2m<- nothing wrong. This is all a log can say about itself.\u001b[0m\r\n"]
[1.401, "o", "\r\n\u001b[1m\u001b[36m-- 8. What the full check sees\u001b[0m\r\n\u001b[2m   The same log. This time it also asks the witness what it remembers.\u001b[0m\r\n\r\n"]
[0.900, "o", "\u001b[2m$ orisan-rec verify /tmp/orisan-demo --tsa-ca /tmp/orisan-demo/tsa-ca.pem\u001b[0m\r\n"]
[0.277, "o", "orisan-rec verify /tmp/orisan-demo\r\n  events: 18  checkpoints: 1  anchors verified: 1\r\n\r\n  timestamp checks were delegated to openssl — re-run these yourself:\r\n    /opt/homebrew/bin/openssl ts -verify -digest c1d2b344ca2374c23e9f8c1cd800632581f13469605e080e84ad09c61a50ac84 -in /tmp/orisan-demo/anchors/00000017.tsr -CAfile /tmp/orisan-demo/tsa-ca.pem\r\n\r\n  attested times (openssl ts -reply -in <tsr> -text):\r\n    checkpoint ..17  2026-08-26T14:43:57.000Z\r\n\r\n  TAMPERED truncation_detected\r\n    the witness holds checkpoint(s) 1 (up to seq 31) that are absent from this log, whose last checkpoint is index 0 and whose last event is seq 17; the tail was removed\r\n\r\n  TAMPERED — see the findings above.\r\n"]
[1.406, "o", "   \u001b[31mexit 1\u001b[0m\r\n"]
[1.402, "o", "\r\n\u001b[1m-- 9.\u001b[0m\r\n\u001b[1m   The log said it was fine. The witness said a checkpoint is missing.\u001b[0m\r\n\u001b[2m   Deleting the end of a log leaves something that still looks consistent,\u001b[0m\r\n\u001b[2m   which is why the check at step 7 returned 0. A record kept where the\u001b[0m\r\n\u001b[2m   operator cannot reach it is what closes that gap.\u001b[0m\r\n\r\n"]
[0.014, "x", "0"]
