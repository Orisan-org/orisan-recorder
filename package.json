{
  "name": "orisan-recorder",
  "version": "0.1.0",
  "description": "Records what your AI agents do, in a form someone else can check.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "orisan-rec": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run build:ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:ui": "cd ui && npm install --silent --no-audit --no-fund && vite build",
    "ui": "tsx src/cli.ts ui",
    "pretest": "npm run build:ui",
    "prepack": "npm run build",
    "start": "node dist/cli.js start"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "sodium-native": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "orisan-witness": "file:../orisan-witness",
    "puppeteer": "^25.7.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "ui/dist",
    "install.sh",
    "README.md"
  ]
}
